# Anthropic — required for all agents
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — required for embeddings (text-embedding-3-small) and RAGAS eval judge
OPENAI_API_KEY=sk-...

# Tavily — required for MarketResearchAgent web search
# Get a free key at https://tavily.com
TAVILY_API_KEY=tvly-...

# ── LangSmith (optional but strongly recommended) ─────────────────────────────
# Enables full observability: per-agent latency, token counts, prompt/response
# for every Claude call, and the full LangGraph execution DAG.
#
# Setup:
#   1. Create a free account at https://smith.langchain.com
#   2. Settings → API Keys → Create API Key
#   3. Set LANGCHAIN_PROJECT to a name like "dealflow-agent-prod"
#
# When set, GET /result/{job_id} returns a langsmith_trace_url field
# that the ObservabilityPanel renders as a clickable link.
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=dealflow-agent
# DO NOT set LANGCHAIN_TRACING_V2 manually — src/utils/tracing.py sets it
# programmatically when LANGCHAIN_API_KEY is present.

# ── PostgreSQL + pgvector ─────────────────────────────────────────────────────
# Matches docker-compose.yml defaults for local dev.
# In AWS, this points to your RDS instance (see infra/README.md).
DATABASE_URL=postgresql+psycopg://dealflow:dealflow@localhost:5432/dealflow

# ── Model config ──────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-small

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json = structured JSON for CloudWatch/Datadog; console = human-readable dev output
LOG_FORMAT=json
