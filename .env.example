# Anthropic — required for all agents
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — required for embeddings (text-embedding-3-small) and RAGAS eval judge
OPENAI_API_KEY=sk-...

# Tavily — required for MarketResearchAgent web search
# Get a free key at https://tavily.com
TAVILY_API_KEY=tvly-...

# LangSmith — optional, enables agent tracing (Phase 2)
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=dealflow-agent

# PostgreSQL + pgvector (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://dealflow:dealflow@localhost:5432/dealflow

# Model config — override to pin a specific version
CLAUDE_MODEL=claude-sonnet-4-20250514
EMBEDDING_MODEL=text-embedding-3-small

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
